<script is:inline>
/* /seo-shopify · TOC build + scroll-spy + reading progress + mobile drawer.
   ~2.3 KB, no dependencies, honours prefers-reduced-motion. */
(function () {
  var doc = document, secs = [].slice.call(doc.querySelectorAll('.p-seosh .sec[data-toc]'));
  var list = doc.getElementById('tocList'), fill = doc.getElementById('tocFill');
  var bar = doc.getElementById('progBar'), fab = doc.getElementById('tocFab');
  var fabNum = doc.getElementById('fabNum'), fabTxt = doc.getElementById('fabTxt');
  var toc = doc.getElementById('toc'), scrim = doc.getElementById('tocScrim');
  var links = [];

  /* ── build TOC from the sections themselves ─────────────────────────── */
  secs.forEach(function (s) {
    var li = doc.createElement('li'), a = doc.createElement('a');
    a.href = '#' + s.id;
    a.innerHTML = '<i>' + s.dataset.chapter + '</i><span>' + s.dataset.toc + '</span>';
    a.setAttribute('aria-current', 'false');
    li.appendChild(a); list.appendChild(li); links.push(a);
  });

  /* ── reading time from the real article text ────────────────────────── */
  var words = (doc.getElementById('guide').innerText.match(/[^\s]+/g) || []).length;
  var mins = Math.round(words / 190);
  var rt = mins + ' דקות קריאה';
  var r1 = doc.getElementById('readTime'), r2 = doc.getElementById('readTime2');
  if (r1) r1.textContent = rt;
  if (r2) r2.textContent = mins + ' דק׳';

  /* ── scroll-spy + progress ──────────────────────────────────────────── */
  var active = -1, raf = 0;
  function paint() {
    raf = 0;
    var st = window.scrollY || doc.documentElement.scrollTop;
    var h = doc.documentElement.scrollHeight - window.innerHeight;
    bar.style.inlineSize = (h > 0 ? Math.min(100, (st / h) * 100) : 0) + '%';

    var probe = st + window.innerHeight * 0.28, i = 0;
    for (var n = 0; n < secs.length; n++) if (secs[n].offsetTop <= probe) i = n;
    if (i !== active) {
      active = i;
      links.forEach(function (a, n) { a.setAttribute('aria-current', n === i ? 'true' : 'false'); });
      var a = links[i], r = a.getBoundingClientRect(), lr = list.getBoundingClientRect();
      fill.style.blockSize = Math.max(0, r.top - lr.top + r.height / 2 - 6) + 'px';
      fabNum.textContent = secs[i].dataset.chapter;
      fabTxt.textContent = secs[i].dataset.toc;
    }
    fab.dataset.hide = st < 260 ? 'true' : 'false';
  }
  function onScroll() { if (!raf) raf = requestAnimationFrame(paint); }
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
  paint();

  /* ── mobile drawer ──────────────────────────────────────────────────── */
  function setOpen(o) {
    toc.dataset.open = o ? 'true' : 'false';
    scrim.dataset.open = o ? 'true' : 'false';
    fab.setAttribute('aria-expanded', o ? 'true' : 'false');
  }
  fab.addEventListener('click', function () { setOpen(toc.dataset.open !== 'true'); });
  scrim.addEventListener('click', function () { setOpen(false); });
  toc.addEventListener('click', function (e) { if (e.target.closest('a')) setOpen(false); });
  addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });

  /* ── horizontal-scroll fade hint on tables ──────────────────────────── */
  [].forEach.call(doc.querySelectorAll('.p-seosh .tbl-wrap'), function (w) {
    var sc = w.querySelector('.tbl-scroll');
    function chk() { w.dataset.fade = sc.scrollWidth - sc.clientWidth > 8 ? 'true' : 'false'; }
    sc.addEventListener('scroll', chk, { passive: true }); addEventListener('resize', chk); chk();
  });

  /* ── entrance animation ─────────────────────────────────────────────── */
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    doc.documentElement.classList.add('js-anim');
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -12% 0px' });
    [].forEach.call(doc.querySelectorAll('.p-seosh .fade-up'), function (el) { io.observe(el); });
  } else {
    [].forEach.call(doc.querySelectorAll('.p-seosh .fade-up'), function (el) { el.classList.add('in'); });
  }
})();
</script>

