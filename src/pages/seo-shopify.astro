<style>
  .svc-hero { padding-block-end: 16px; }
  .svc-hero .lede { max-inline-size: 62ch; margin-inline: auto; }
  .hero-sub { font-size: 17px; font-weight: 700; color: var(--sc-muted); margin-block: 8px 2px; }
  .lede.opening { color: var(--sc-ink); }
  .lede.opening strong { font-weight: 600; }
  .byline { font-size: 13.5px; color: var(--sc-muted); margin-block: 6px 14px; font-weight: 500; }
  .byline a { font-weight: 700; }
  .cta-note { font-size: 13px; color: var(--sc-disabled); margin-block-start: 14px; }
  .alt-bg { background: var(--sc-card); }
  :global([data-theme='dark']) .alt-bg { background: #17141d; }

  .svc-tldr { padding-block: 8px; }
  .tldr { padding: 22px 24px; border-inline-start: 4px solid var(--sc-accent); background: var(--sc-wash); }
  .tldr-tag {
    display: inline-block; font-size: 12px; font-weight: 800; letter-spacing: .04em;
    color: var(--sc-accent-text); margin-block-end: 8px;
    text-transform: uppercase;
  }
  .tldr p { font-size: 16px; color: var(--sc-ink); line-height: 1.75; margin: 0; }

  .prose p { max-inline-size: 68ch; margin-inline: auto; margin-block-end: 14px; font-size: 16px; }
  .prose { margin-block-end: 8px; }
  .prose code {
    font-size: 13.5px; background: var(--sc-wash); border: 1px solid var(--sc-hair);
    padding: 1px 6px; border-radius: 6px; direction: ltr; unicode-bidi: embed;
  }
  .prose .lead { font-weight: 600; color: var(--sc-ink); }
  .prose .ck-h { max-inline-size: 68ch; margin-inline: auto; font-size: 16.5px; margin-block: 22px 10px; }
  .ck { list-style: none; max-inline-size: 68ch; margin: 0 auto 6px; padding: 0; display: grid; gap: 8px; }
  .ck li { position: relative; padding-inline-start: 28px; font-size: 15px; color: var(--sc-muted); line-height: 1.65; }
  .ck li::before {
    content: '✓'; position: absolute; inset-inline-start: 2px; inset-block-start: 0;
    color: var(--sc-accent-text); font-weight: 800;
  }
  .mistakes {
    max-inline-size: 68ch; margin: 6px auto 0; padding-inline-start: 24px;
    display: grid; gap: 12px; font-size: 15.5px; line-height: 1.75; color: var(--sc-muted);
  }
  .mistakes li::marker { font-weight: 800; color: var(--sc-accent-text); }
  .mistakes strong { color: var(--sc-ink); }

  /* ── inline diagrams ── */
  .fig { max-inline-size: 68ch; margin: 18px auto 26px; }
  .fig svg { display: block; inline-size: 100%; block-size: auto; }
  .fig figcaption { font-size: 13px; color: var(--sc-disabled); text-align: center; margin-block-start: 8px; }
  .dg-box { fill: var(--sc-paper); stroke: var(--sc-hair); stroke-width: 1.5; }
  .dg-box.wash { fill: var(--sc-wash); }
  .dg-box.dup { stroke-dasharray: 6 4; fill: var(--sc-wash); }
  .dg-box.canon { stroke: var(--sc-accent-text); stroke-width: 2; fill: var(--sc-wash); }
  .dg-line { fill: none; stroke: var(--sc-muted); stroke-width: 1.5; }
  .dg-canonline { fill: none; stroke: var(--sc-accent-text); stroke-width: 1.75; stroke-dasharray: 6 4; }
  .dg-arrhead { fill: var(--sc-muted); }
  .dg-arrhead-acc { fill: var(--sc-accent-text); }
  .dg-t { font-size: 14px; font-weight: 700; fill: var(--sc-ink); direction: rtl; }
  .dg-s { font-size: 12px; font-weight: 500; fill: var(--sc-muted); direction: rtl; }
  .dg-s.acc { fill: var(--sc-accent-text); font-weight: 700; direction: ltr; }
  .dg-code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; fill: var(--sc-ink); direction: ltr; }
  .dg-code.strong { font-weight: 700; font-size: 14px; fill: var(--sc-accent-text); }
  .dg-code-inline { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; direction: ltr; unicode-bidi: embed; }
  .dg-bar { stroke-width: 1.5; }
  .dg-bar.wide { fill: var(--sc-wash); stroke: var(--sc-accent-text); }
  .dg-bar.narrow { fill: var(--sc-paper); stroke: var(--sc-hair); }
  .dg-bt { font-size: 12.5px; font-weight: 600; fill: var(--sc-ink); direction: rtl; }

  /* ── checklist infographic grid ── */
  .ckg { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-block-start: 10px; }
  @media (max-width: 720px) { .ckg { grid-template-columns: 1fr; } }
  .ckg-card { padding: 20px 22px; background: var(--sc-paper); }
  .ckg-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-block-end: 12px; padding-block-end: 10px; border-block-end: 1px solid var(--sc-hair);
  }
  .ckg-head h3 { font-size: 16.5px; margin: 0; }
  .ckg-count {
    font-size: 12px; font-weight: 800; color: var(--sc-accent-text);
    background: var(--sc-wash); border: 1px solid var(--sc-soft);
    padding: 3px 10px; border-radius: 999px; white-space: nowrap;
  }
  .ckg .ck { max-inline-size: none; margin: 0; }
  .ckg .ck li { font-size: 14.5px; }
  .tools-h { max-inline-size: 68ch; margin: 26px auto 12px; font-size: 17px; }

  .tbl-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; margin-block-start: 18px; }
  table.cmp {
    inline-size: 100%; border-collapse: collapse; margin-inline: auto;
    font-size: 15px; background: var(--sc-paper); border-radius: 14px; overflow: hidden;
    border: 1px solid var(--sc-hair);
  }
