    .p-wp .wp-price-lede { max-inline-size: 68ch; margin: 0 0 26px; font-size: 16.5px; line-height: 1.75; }
    .p-wp .wp-links { margin-block-start: 22px; font-size: 15.5px; }
    .p-wp .wp-form { margin-block-start: 24px; display: grid; gap: 16px; max-inline-size: 40rem; }
    .p-wp .wp-field { display: grid; gap: 6px; }
    .p-wp .wp-field label { font-weight: 700; font-size: 15px; }
    .p-wp .wp-opt { font-weight: 400; color: var(--sc-muted); }
    .p-wp .wp-field input {
      font: inherit; font-size: 16px; padding: 12px 14px; border-radius: 11px;
      border: 1.5px solid var(--sc-hair); background: var(--sc-card); color: var(--sc-ink);
    }
    .p-wp .wp-field input:focus-visible { outline: 2.5px solid var(--sc-accent); outline-offset: 2px; }
    .p-wp .wp-err { margin: 0; color: #c02a22; font-size: 14px; font-weight: 600; }
    .p-wp .wp-hp { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); }
    .p-wp .wp-submit { justify-self: start; cursor: pointer; font-family: inherit; }
    .p-wp .wp-submit[disabled] { opacity: .6; cursor: progress; }
    .p-wp .wp-consent { font-size: 13.5px; color: var(--sc-muted); margin: 0; }
    .p-wp .wp-status { margin: 0; font-size: 16px; font-weight: 700; line-height: 1.6; }
    .p-wp .wp-status[data-ok='true'] { color: var(--sc-gold-text); }
    .p-wp .wp-status[data-ok='false'] { color: #c02a22; }

    @media (max-width: 640px) {
      .p-wp .btn-wp { inline-size: 100%; }
      .p-wp .wp-steps li { flex-direction: column; }
    }
    @media (prefers-reduced-motion: reduce) {
      .p-wp .btn-wp { transition: none; }
      .p-wp .btn-wp:hover { transform: none; }
    }
  </style>

  <script is:inline>
    (function () {
      var f = document.getElementById('wpForm');
      if (!f) return;
      var status = document.getElementById('wpStatus');
      var btn = document.getElementById('wpSubmit');
      var show = function (el, msg) { el.textContent = msg; el.hidden = !msg; };

      f.addEventListener('submit', async function (e) {
        e.preventDefault();
        ['site', 'email'].forEach(function (k) { show(document.getElementById('err-' + k), ''); });
        status.hidden = true;

        var data = {
          site: f.site.value,
          email: f.email.value,
          name: f.name.value,
          company_website: f.company_website.value,
        };

        btn.disabled = true;
        try {
          var res = await fetch('/api/wp-signup', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(data),
          });
          var out = await res.json().catch(function () { return {}; });

          if (res.ok && out.ok) {
            f.reset();
            status.dataset.ok = 'true';
            show(status, 'קיבלנו. נשלח אליכם את קישור ההתקנה ואת הוראות החיבור לאימייל שהשארתם.');
            return;
          }
          if (out.errors) {
            Object.keys(out.errors).forEach(function (k) {
              var el = document.getElementById('err-' + k);
              if (el) show(el, out.errors[k]);
            });
            return;
          }
          throw new Error('failed');
        } catch (err) {
          status.dataset.ok = 'false';
          show(status, 'משהו השתבש בשליחה. אפשר לכתוב לנו ישירות ל-lior+scayla@mrmake.co.il ונחבר אתכם.');
        } finally {
          btn.disabled = false;
        }
      });
    })();
  </script>
</BaseLayout>
