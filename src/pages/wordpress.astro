    .p-wp .btn-wp-1 { background: var(--sc-accent); color: #fff; box-shadow: 0 10px 24px -12px color-mix(in oklch, var(--sc-accent) 70%, transparent); }
    .p-wp .btn-wp-1 small { font-size: 11.5px; font-weight: 600; opacity: .9; }
    .p-wp .btn-wp-2 { border-color: var(--sc-hair); color: var(--sc-ink); background: var(--sc-card); }
    .p-wp .wp-fine { font-size: 13.5px; color: var(--sc-muted); margin-block-start: 14px; }

    .p-wp .wp-sec { padding-block: clamp(40px, 6vw, 76px); }
    .p-wp .wp-sec.alt { background: color-mix(in oklch, var(--sc-lav) 6%, transparent); }

    /* שני הגרידים מחזיקים 4 פריטים · 2×2 מאוזן, ולא 3 + יתום בשורה שנייה. */
    .p-wp .wp-grid { display: grid; gap: 18px; grid-template-columns: 1fr; }
    @media (min-width: 880px) { .p-wp .wp-grid { grid-template-columns: 1fr 1fr; } }
    .p-wp .wp-card {
      background: var(--sc-card); border: 1px solid var(--sc-hair);
      border-radius: var(--wp-rad); padding: 24px;
    }
    .p-wp .wp-card h3 { font-size: 18.5px; line-height: 1.35; margin: 0 0 10px; }
    .p-wp .wp-card p { margin: 0; font-size: 16px; line-height: 1.75; color: var(--sc-ink); }
    .p-wp .wp-card-quiet { background: transparent; border-style: dashed; }
    .p-wp .wp-card-quiet p { color: var(--sc-muted); }
    .p-wp .wp-num {
      display: block; font-size: 13px; font-weight: 800; letter-spacing: .06em;
      color: var(--sc-accent-text); margin-block-end: 8px; font-variant-numeric: tabular-nums;
    }

    .p-wp .wp-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
    .p-wp .wp-steps li { display: flex; gap: 16px; align-items: flex-start; background: var(--sc-card); border: 1px solid var(--sc-hair); border-radius: var(--wp-rad); padding: 20px 22px; }
    .p-wp .wp-step-n {
      flex: none; inline-size: 34px; block-size: 34px; border-radius: 50%;
      display: grid; place-items: center; font-weight: 800; font-size: 15px;
      background: var(--sc-accent); color: #fff;
    }
    .p-wp .wp-steps h3 { margin: 0 0 6px; font-size: 17.5px; }
    .p-wp .wp-steps p { margin: 0; font-size: 15.8px; line-height: 1.72; color: var(--sc-ink); }
    .p-wp .wp-note {
      margin-block-start: 20px; padding: 16px 18px; border-radius: 12px;
      background: var(--sc-card); border: 1px solid var(--sc-hair);
      font-size: 15.5px; line-height: 1.7;
    }

    .p-wp code {
      direction: ltr; unicode-bidi: isolate; font-size: .92em;
      background: color-mix(in oklch, var(--sc-lav) 16%, transparent);
      padding: 1px 7px; border-radius: 6px;
    }

    .p-wp .wp-faq details {
      border-block-end: 1px solid var(--sc-hair); padding-block: 14px;
    }
    .p-wp .wp-faq summary {
      cursor: pointer; font-weight: 700; font-size: 17px; line-height: 1.5;
      list-style: none; padding-inline-end: 26px; position: relative;
    }
    .p-wp .wp-faq summary::-webkit-details-marker { display: none; }
    .p-wp .wp-faq summary::after {
      content: '+'; position: absolute; inset-inline-end: 0; inset-block-start: 0;
      font-weight: 400; font-size: 22px; color: var(--sc-accent-text); line-height: 1.2;
    }
    .p-wp .wp-faq details[open] summary::after { content: '−'; }
