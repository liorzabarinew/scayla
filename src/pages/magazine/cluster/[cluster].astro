---
import { getCollection } from 'astro:content';
import { CLUSTERS, CLUSTER_SLUGS, clusterPath } from '../../../content.config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CtaBand from '../../../components/CtaBand.astro';

export async function getStaticPaths() {
  const posts = await getCollection('magazine', ({ data }) => !data.draft);
  return CLUSTERS.map((cluster) => ({
    params: { cluster: CLUSTER_SLUGS[cluster] },
    props: {
      cluster,
      posts: posts
        .filter((p) => p.data.cluster === cluster)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { cluster, posts } = Astro.props;
const fmt = new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'long', year: 'numeric' });

// Short human intro per cluster · sets topical context for the silo page.
const intros: Record<string, string> = {
  'GEO ואופטימיזציה למנועי AI':
    'איך נכנסים לתשובות של ChatGPT, Gemini ו-Perplexity · מה שונה מ-SEO רגיל, מה מודדים, ומאיפה מתחילים.',
  'SEO לחנויות שופיפיי':
    'קידום אורגני לחנות Shopify · מבנה קטגוריות, תיאורי מוצר, סכמות ומהירות · המדריכים שהופכים ביקורים לתנועה חוזרת.',
  'שיווק לאיקומרס ישראלי':
    'מה עובד בשיווק לחנויות ישראליות · מהתנועה האורגנית ועד ההמרה, עם הדגשים המקומיים של השוק בעברית.',
  'מדריכים וכלים':
    'מדריכים מעשיים וכלים לבדיקה עצמית · צעד-אחר-צעד, בלי ז\'רגון, כדי שתדעו בדיוק מה לעשות.',
};
const intro = intros[cluster] ?? '';

// C5 · פרוזת-עוגן לכל אשכול · דף-hub בלי טקסט אמיתי הוא דף ריק בעיני מנוע.
// כל מאמר באתר מקשר לכאן, אז לדף מגיע גוף של ממש: מה הנושא, למה הוא חשוב, מה מוצאים.
const pillarProse: Record<string, { heading: string; paragraphs: string[] }> = {
  'GEO ואופטימיזציה למנועי AI': {
    heading: 'מה זה GEO ולמה זה נוגע לחנות שלכם',
    paragraphs: [
      'GEO (Generative Engine Optimization, אופטימיזציה למנועים גנרטיביים) הוא העבודה שגורמת למנועי AI כמו ChatGPT, Gemini ו-Perplexity להזכיר את החנות שלכם כשקונים שואלים אותם שאלה. וזה כבר קורה: חלק הולך וגדל מהקונים בישראל לא פותח את גוגל, אלא שואל צ\'אט "איזה מוצר כדאי לקנות" ומקבל תשובה עם שלושה או ארבעה שמות. אם החנות שלכם לא ברשימה הזאת, היא פשוט לא קיימת בשיחה.',
      'ההבדל מ-SEO קלאסי מהותי. בגוגל נלחמים על מיקום ברשימת תוצאות, ובמנוע AI נלחמים על ציטוט בתוך תשובה אחת. המנועים מעדיפים מקורות שמנוסחים ברור, עונים על שאלות באופן ישיר, ומסמנים את המידע שלהם בסכמה (Schema, קוד שמסביר למנוע מה יש בעמוד). בעברית התחרות על הציטוטים האלה עדיין קטנה, וזה בדיוק החלון: מי שמסדר את התוכן שלו עכשיו מגדיל את הסיכוי להיכנס למאגר שהמנועים שואבים ממנו.',
      'באשכול הזה תמצאו הסברים על איך המנועים בוחרים את המקורות שלהם, דרכים לבדוק אם ה-AI מכיר את החנות שלכם כבר היום, והצעדים המעשיים לפי סדר: מהתוכן ועד הסימון הטכני. בלי הבטחות קסם, עם עבודה שאפשר להתחיל השבוע.',
    ],
  },
  'SEO לחנויות שופיפיי': {
    heading: 'קידום אורגני שמותאם למבנה של Shopify',
    paragraphs: [
      'SEO (קידום אורגני, הופעה בתוצאות החיפוש בלי לשלם על מודעות) לחנות Shopify הוא משחק קצת שונה מקידום אתר רגיל. לפלטפורמה יש מבנה קבוע: קטגוריות תחת ‎/collections, עמודי מוצר עם וריאציות שמייצרות תוכן כפול, ותבניות שכותבות לבד כותרות זהות לעשרות עמודים. מי שלא מכיר את המוזרויות האלה משאיר תנועה על הרצפה.',
      'לבעלי חנויות בישראל זה חשוב במיוחד. נפחי החיפוש בעברית קטנים יחסית, אז כל מיקום שווה יותר, ומחירי המודעות רק עולים. תנועה אורגנית היא הנכס שמצטבר: עמוד קטגוריה או מאמר שמדורג יכול להמשיך להביא קונים גם חודשים אחרי שפורסם, בלי תקציב יומי.',
      'כאן תמצאו מדריכים על מבנה קטגוריות נכון, כתיבת תיאורי מוצר שגם גוגל וגם קונים מבינים, סכמות (קוד שמסמן למנוע החיפוש מה יש בעמוד: מחיר, מלאי, ביקורות), מהירות טעינה וקישורים פנימיים. כל מדריך נכתב על Shopify ספציפית, עם המסכים והשמות שאתם רואים בממשק, לא עצות כלליות שצריך לתרגם לבד. ואם אתם מתלבטים מאיפה להתחיל, התחילו מעמודי הקטגוריה: הם אלה שמתמודדים על החיפושים הרחבים באמת, ורוב החנויות משאירות אותם כמעט ריקים.',
    ],
  },
  'שיווק לאיקומרס ישראלי': {
    heading: 'שיווק שמדבר בשפה של השוק המקומי',
    paragraphs: [
      'להביא תנועה לחנות זה חצי מהעבודה. האשכול הזה עוסק בחצי השני: מה קורה מהרגע שקונה ישראלי נוחת בחנות ועד שהוא משלם, חוזר וממליץ. עגלות נטושות, רשימות תפוצה, מבצעי חגים, ביקורות של לקוחות, וכל מה שהופך ביקור חד-פעמי ללקוח קבוע. העלות של הבאת קונה חדש רק עולה, אז הערך של כל לקוח שנשאר גדל בהתאם.',
      'למה אשכול נפרד לשוק הישראלי? כי הוא באמת שונה. לוח השנה המסחרי כאן בנוי סביב החגים ולא רק סביב בלאק פריידיי, קונים מצפים למשלוח מהיר ולשירות בעברית, אמצעי תשלום מקומיים משפיעים על ההחלטה בקופה, והשוק קטן מספיק כדי ששירות גרוע מתפרסם מהר. עצות מתורגמות מבלוגים אמריקאיים מפספסות את כל אלה.',
      'תמצאו כאן מאמרים מעשיים על שיפור יחס ההמרה (האחוז מהמבקרים שבאמת קונים), בניית קהל שחוזר בלי תלות במודעות, ותזמון קמפיינים ללוח השנה הישראלי. הכול כתוב מנקודת המבט של חנות קטנה או בינונית: תקציב מוגבל, צוות של איש אחד או שניים, ובלי ז\'רגון שדורש תואר בשיווק. רוב הצעדים גם אפשריים ישירות מתוך Shopify, בלי להוסיף מערכת חדשה רק בשביל להתחיל.',
    ],
  },
  'מדריכים וכלים': {
    heading: 'מדריכים שאפשר לבצע לבד, צעד אחרי צעד',
    paragraphs: [
      'לא לכל משימה צריך סוכנות. חלק גדול מעבודת הקידום של חנות אפשר לעשות לבד: לבדוק מה גוגל רואה, לתקן כותרות, להוסיף סכמה בסיסית, למדוד מהירות טעינה. הבעיה היא שרוב ההסברים ברשת כתובים למקדמי אתרים, לא לבעלי חנויות. האשכול הזה סוגר את הפער. וגם מי שעובד עם איש מקצוע מרוויח מלהבין את העבודה: קל יותר לדעת מה לבקש, ומה לבדוק כשמקבלים דוח.',
      'כל מדריך כאן בנוי אותו דבר: מה בודקים, איך בודקים, מה עושים עם התוצאה. בלי הנחות מוקדמות על ידע טכני, וכל מונח מקצועי מוסבר במקום הראשון שהוא מופיע. אם מדריך דורש כלי, הוא יהיה חינמי או כזה שכבר יש לכם, כמו Google Search Console (הלוח שבו גוגל מראה איך הוא רואה את האתר שלכם).',
      'זה גם המקום להתחיל בו אם רק נכנסתם לעולם הזה. המדריכים מסודרים כך שאפשר לבצע אחד בכל פעם, בחצי שעה עד שעה, ולראות מה השתנה לפני שממשיכים הלאה. קידום חנות הוא לא פרויקט של פעם אחת אלא הרגל, והדרך הכי טובה לבנות הרגל היא צעדים קטנים שנגמרים.',
    ],
  },
};
const about = pillarProse[cluster];

// מאמר-pillar · הדגל מגיע מהאוסף (נוסף במקביל בתהליך אחר) · בדיקה הגנתית בזמן
// ריצה: כשהשדה עוד לא קיים אין קלף מובלט והדף נבנה כרגיל.
const pillarPost = posts.find((p) => (p.data as Record<string, unknown>)?.pillar === true);
const gridPosts = pillarPost ? posts.filter((p) => p.id !== pillarPost.id) : posts;

const title = `${cluster} · הבלוג של Scayla`;
const description =
  intro.length <= 130 ? intro : `${cluster} · מדריכים מבוססי מחקר בעברית תקנית מהבלוג של Scayla.`;

const clusterUrl = clusterPath(cluster);
const SITE = 'https://scayla.co.il';

// CollectionPage + ItemList · הופך את דף-האשכול ל-hub טופולוגי שגוגל ומנועי-AI
// קוראים כאוסף מאמרים מוסמך סביב נושא. אות-pillar דטרמיניסטי (בלי תוכן חדש).
const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE}${clusterUrl}`,
  name: cluster,
  description,
  inLanguage: 'he-IL',
  // ה-Blog מוגדר כאן inline במלואו (type + name + url) · אין עמוד אחר שמגדיר את
  // הצומת, אז הפניה עירומה ל-@id הייתה נשארת תלויה באוויר בלי ישות מאחוריה
  isPartOf: { '@type': 'Blog', '@id': `${SITE}/magazine`, name: 'הבלוג של Scayla', url: `${SITE}/magazine` },
  // ה-Organization הקנוני נפלט פעם אחת ב-BaseLayout · כאן הפניה בלבד, בלי הגדרה מחדש
  publisher: { '@id': `${SITE}/#org` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE}/magazine/${post.id}`,
      name: post.data.title,
    })),
  },
};
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[
    { name: 'בלוג', path: '/magazine' },
    { name: cluster, path: clusterUrl },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionLd)} />

  <section class="cl-hero">
    <div class="narrow center">
      <nav class="crumbs" aria-label="פירורי לחם">
        <a href="/magazine">בלוג</a>
        <span aria-hidden="true">‹</span>
        <span>{cluster}</span>
      </nav>
      <span class="eyebrow">אשכול תוכן</span>
      <h1>{cluster}</h1>
      {intro && <p class="lede">{intro}</p>}
      <p class="count"><span class="num">{posts.length}</span> מאמרים באשכול</p>
    </div>
  </section>

  {about && (
    <section class="cl-about">
      <div class="narrow">
        <h2>{about.heading}</h2>
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </section>
  )}

  <section class="cl-list">
    <div class="wrap">
      {posts.length > 0 ? (
        <div class="grid">
          {pillarPost && (
            <article class="post card pillar fade-up">
              <a href={`/magazine/${pillarPost.id}`} class="post-link">
                {pillarPost.data.coverImage ? (
                  <div class="thumb has-img">
                    <img src={pillarPost.data.coverImage} alt={pillarPost.data.title} loading="lazy" width="600" height="240" />
                  </div>
                ) : (
                  <div class="thumb" aria-hidden="true"><span class="cat">{pillarPost.data.cluster}</span></div>
                )}
                <div class="body">
                  <span class="start-here">התחילו כאן</span>
                  <h2>{pillarPost.data.title}</h2>
                  <p>{pillarPost.data.description}</p>
                  <div class="meta">
                    <time datetime={pillarPost.data.pubDate.toISOString()}>{fmt.format(pillarPost.data.pubDate)}</time>
                    <span aria-hidden="true">·</span>
                    <span><span class="num">{pillarPost.data.readingMinutes}</span> דקות קריאה</span>
                  </div>
                </div>
              </a>
            </article>
          )}
          {gridPosts.map((post) => (
            <article class="post card fade-up">
              <a href={`/magazine/${post.id}`} class="post-link">
                {post.data.coverImage ? (
                  <div class="thumb has-img">
                    <img src={post.data.coverImage} alt={post.data.title} loading="lazy" width="600" height="240" />
                  </div>
                ) : (
                  <div class="thumb" aria-hidden="true"><span class="cat">{post.data.cluster}</span></div>
                )}
                <div class="body">
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                  <div class="meta">
                    <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time>
                    <span aria-hidden="true">·</span>
                    <span><span class="num">{post.data.readingMinutes}</span> דקות קריאה</span>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <p class="empty">עוד אין מאמרים באשכול הזה · מכונת התוכן של Scayla תזרים אותם בקרוב.</p>
      )}
      <p class="back"><a href="/magazine">‹ חזרה לכל הבלוג</a></p>
    </div>
  </section>

  <section class="cl-cta">
    <div class="wrap">
      <CtaBand
        title="רוצים מגזין כזה בחנות שלכם?"
        body="מכונת התוכן של Scayla כותבת מאמרים מבוססי מחקר בעברית תקנית · מכוונים בדיוק לשאלות שהקונים שלכם שואלים את ה-AI."
      />
    </div>
  </section>
</BaseLayout>

<style>
  .cl-hero { padding-block-end: 12px; }
  .crumbs {
    display: flex; gap: 8px; justify-content: center; flex-wrap: wrap;
    font-size: 13px; color: var(--sc-muted); margin-block-end: 18px;
  }
  .crumbs a:hover { color: var(--sc-accent-text); }
  .cl-hero .lede { max-inline-size: 56ch; margin-inline: auto; }
  .count { font-size: 13.5px; color: var(--sc-disabled); margin-block-start: 14px; }

  /* C5 · פרוזת-העוגן · גוף טקסט קריא מתחת להירו, לפני רשת הקלפים */
  .cl-about { padding-block: 10px 6px; }
  .cl-about h2 { font-size: 20px; font-weight: 800; color: var(--sc-ink); margin-block-end: 12px; }
  .cl-about p { font-size: 15.5px; line-height: 1.85; color: var(--sc-muted); }
  .cl-about p + p { margin-block-start: 12px; }

  /* C5 · קלף "התחילו כאן" · שורה מלאה עם הדגשת wash כדי שיקרא ככניסה לאשכול */
  .post.pillar { grid-column: 1 / -1; background: var(--sc-wash); box-shadow: inset 0 0 0 1.5px var(--sc-soft); }
  .post.pillar .thumb { block-size: 150px; }
  .start-here {
    align-self: flex-start;
    background: var(--sc-accent); color: #fff;
    font-size: 11px; font-weight: 800; letter-spacing: .02em;
    border-radius: var(--sc-r-pill); padding: 4px 12px;
  }

  .cl-list { padding-block-start: 24px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
  .post { overflow: hidden; border-radius: 18px; transition: transform .18s var(--sc-ease), box-shadow .18s var(--sc-ease); }
  .post:hover { transform: translateY(-3px); box-shadow: var(--sc-sh-lift); }
  .post-link { display: flex; flex-direction: column; block-size: 100%; color: inherit; }
  .thumb {
    block-size: 130px;
    background: radial-gradient(300px 160px at 80% -30%, rgba(139, 118, 242, .45), transparent 65%), var(--sc-grad);
    display: flex; align-items: flex-end; padding: 14px;
  }
  .thumb.has-img { padding: 0; }
  .thumb.has-img img { inline-size: 100%; block-size: 100%; object-fit: cover; }
  .cat {
    background: rgba(255, 255, 255, .92); color: var(--sc-accent);
    font-size: 11px; font-weight: 800; border-radius: var(--sc-r-pill); padding: 4px 12px;
  }
  .body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .body h2 { font-size: 17px; line-height: 1.4; color: var(--sc-ink); font-weight: 800; }
  .post:hover h2 { color: var(--sc-accent-text); }
  .body p { font-size: 13.5px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .meta {
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    font-size: 12.5px; color: var(--sc-disabled); margin-block-start: auto; padding-block-start: 8px;
  }
  .empty { text-align: center; color: var(--sc-muted); font-size: 15px; padding-block: 24px; }
  .back { text-align: center; margin-block-start: 32px; }
  .back a { font-weight: 700; font-size: 14px; }
  .cl-cta { padding-block-start: 8px; }
</style>
